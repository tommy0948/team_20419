using UnityEngine;
using UnityEngine.UI; // UI를 제어하기 위해 필요

public class CharacterHealth : MonoBehaviour
{
    [Header("Health Settings")]
    public float maxHealth = 100f;
    private float currentHealth;

    [Header("UI")]
    public Slider healthBar; // 체력바 UI (Slider)

    void Start()
    {
        currentHealth = maxHealth;

        // 체력바 초기화
        if (healthBar != null)
        {
            healthBar.maxValue = maxHealth;
            healthBar.value = currentHealth;
        }
    }

    // 데미지를 받는 함수
    public void TakeDamage(float damage)
    {
        currentHealth -= damage;
        
        // 체력바 UI 업데이트
        if (healthBar != null)
        {
            healthBar.value = currentHealth;
        }

        Debug.Log($"{gameObject.name}이(가) {damage}의 데미지를 받았습니다! 남은 체력: {currentHealth}");

        // 체력이 0 이하가 되면 죽음 처리
        if (currentHealth <= 0)
        {
            Die();
        }
    }

    void Die()
    {
        Debug.Log($"{gameObject.name} 처치!");
        // 여기에 죽음 애니메이션 실행이나 오브젝트 삭제 로직 추가
        Destroy(gameObject, 0.5f); // 0.5초 뒤 삭제
    }
}
